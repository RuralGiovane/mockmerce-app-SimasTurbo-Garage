{
  "expo": {
    "name": "Simas Turbo Garage",
    "slug": "simas-turbo-garage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IMG_3357.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/IMG_3357.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1015"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.simasturbogarage"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IMG_3357.png",
        "backgroundColor": "#0F1015"
      },
      "package": "com.anonymous.simasturbogarage"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir anexar fotos às avaliações das peças.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir ordenar os pontos de retirada por distância."
        }
      ]
    ]
  }
}
