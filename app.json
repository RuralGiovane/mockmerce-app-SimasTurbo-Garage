{
  "expo": {
    "name": "Simas Turbo Garage",
    "slug": "simas-turbo-garage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/IMG_3357.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/IMG_3357.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1015"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/IMG_3357.png",
        "backgroundColor": "#0F1015"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
